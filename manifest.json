{
    "display_information": {
        "name": "Welcomer"
    },
    "features": {
        "bot_user": {
            "display_name": "Welcomer",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": ["channels:read", "chat:write"]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://welcomer-blond.vercel.app/api/events",
            "bot_events": ["member_joined_channel"]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "is_hosted": false,
        "token_rotation_enabled": false
    }
}